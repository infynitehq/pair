# Public browser endpoint. Production requires WSS through your reverse proxy.
NEXT_PUBLIC_SIGNALING_URL=ws://localhost:3001/signal

# Optional server-side comma-separated STUN endpoints. Empty means host candidates only.
STUN_URLS=

# Coturn / managed TURN REST-compatible configuration. Both must be set to enable TURN.
# Never prefix TURN_SHARED_SECRET with NEXT_PUBLIC_. Leave all TURN fields empty to disable.
TURN_URLS=
TURN_SHARED_SECRET=
# TURN_CREDENTIAL_TTL_SECONDS=600

# Signaling service configuration (server process, not browser variables).
SIGNALING_PORT=3001
SIGNALING_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
